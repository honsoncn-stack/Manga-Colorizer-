{
  "name": "manga-auto-colorizer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Manga Auto Colorizer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "build": "npm --prefix frontend run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.mangacolorizer.desktop",
    "productName": "Manga Auto Colorizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
