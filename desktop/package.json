{
  "name": "manga-auto-colorizer-desktop",
  "version": "1.0.0",
  "private": true,
  "productName": "Manga Auto Colorizer",
  "appId": "com.local.mangaautocolorizer",
  "description": "Electron desktop shell for Manga Auto Colorizer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "productName": "Manga Auto Colorizer",
    "appId": "com.local.mangaautocolorizer",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/server.py",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manga Auto Colorizer",
      "uninstallDisplayName": "Manga Auto Colorizer"
    }
  }
}
